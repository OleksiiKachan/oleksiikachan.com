{
  "name": "oleksiikachan.com",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build --turbo",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "check-types": "tsc --noEmit",
    "pre-commit": "npm-run-all -p pre-commit:*",
    "pre-commit:lint": "pnpm lint --fix && pnpm pretty-quick --staged",
    "pre-commit:test": "vitest run --changed"
  },
  "engines": {
    "node": "24"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".commitizen.json"
    }
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^13.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.8",
    "pretty-quick": "^4.2.2",
    "sass": "^1.104.1",
    "shimmer": "^1.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
